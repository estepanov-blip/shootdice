{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true
  },
  "include": ["./**/*.ts", "../src/game/rules.ts", "../src/game/rng.ts", "../src/online/protocol.ts", "../src/online/replay.ts"],
  "exclude": ["./**/*.test.ts"]
}
