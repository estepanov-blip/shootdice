{
  "name": "shootdice",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "SHOOT DICE \u2014 Street Dice Club. Telegram Mini App: practice vs bot + duels with friends.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p server/tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "deploy": "npm run build && wrangler deploy",
    "typecheck:server": "tsc -p server/tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "phaser": "^3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
