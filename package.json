    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
